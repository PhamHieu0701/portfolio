---
import { siteConfig } from "../config";
import "../styles/global.css";
const email = "mailto:" + siteConfig.social.email;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteConfig.description} />
    <meta name="theme-color" content="#111512" />
    <meta property="og:title" content={siteConfig.name + " | Backend Engineer"} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:type" content="website" />
    <title>{siteConfig.name} | Backend Engineer</title>
  </head>
  <body class="bg-[#111512] text-[#f2f4ec] antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="mx-auto max-w-6xl px-6 md:px-12">
      <header class="flex flex-wrap items-center justify-between gap-6 border-b border-white/15 py-7">
        <a href="#" class="brand" aria-label="Hieu's portfolio home">PH <span>/ ENGINEER</span></a>
        <nav aria-label="Main navigation" class="flex flex-wrap gap-x-6 gap-y-3 text-xs font-semibold tracking-widest">
          <a href="#about">ABOUT</a><a href="#ai-workflow">AI WORKFLOW</a><a href="#work">WORK</a><a href="#contact">CONTACT</a>
        </nav>
      </header>
      <main id="main">
        <section class="hero grid items-end gap-12 py-20 md:grid-cols-[1fr_260px] md:py-28" aria-labelledby="intro">
          <div>
            <p class="eyebrow mb-7">BACKEND ENGINEER · HO CHI MINH CITY, VN</p>
            <h1 id="intro" class="text-5xl font-semibold leading-[1.06] tracking-tight md:text-7xl">Hi, I'm Hieu.<br />I build reliable<br /><span class="accent">backend systems.</span></h1>
            <p class="mt-8 max-w-xl text-lg leading-relaxed text-[#b6beb3]">6+ years with PHP, real-time systems, and databases. I turn complex workflows into software that people can depend on, using a structured AI-assisted workflow with hands-on review and testing.</p>
            <div class="mt-9 flex flex-wrap gap-4">
              <a href="#work" class="button-primary">Explore my work <span aria-hidden="true">↘</span></a>
              <a href={email} class="button-secondary">Let's talk <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="system-card" aria-label="Engineering focus">
            <p class="eyebrow">ENGINEERING FOCUS</p>
            <div class="system-line"><span>01</span> Backend services</div>
            <div class="system-line"><span>02</span> Data integrity</div>
            <div class="system-line"><span>03</span> Real-time delivery</div>
            <div class="mt-7 border-t border-white/15 pt-5 text-xs text-[#b6beb3]"><span class="status-dot"></span>Currently building at SePay</div>
          </aside>
        </section>
        <section id="about" class="section-grid" aria-labelledby="about-title">
          <div><p class="eyebrow">01 / ABOUT</p><h2 id="about-title" class="section-title">Built on<br />experience.</h2></div>
          <div>
            <p class="text-xl leading-relaxed text-[#d5dbd0]">{siteConfig.aboutMe}</p>
            <div class="mt-8 grid gap-6 sm:grid-cols-2">
              <div><h3 class="mb-2 font-semibold">Production ownership</h3><p class="muted">Requirements, implementation, SQL tuning, debugging, and verified fixes.</p></div>
              <div><h3 class="mb-2 font-semibold">AI-assisted. Developer-verified.</h3><p class="muted">I work effectively with ChatGPT and Claude: clear context, focused tasks, iterative implementation, and independent code review and testing.</p></div>
            </div>
            <h3 class="eyebrow mb-4 mt-10">TOOLS I WORK WITH</h3>
            <ul class="flex flex-wrap gap-2" aria-label="Technical skills">{siteConfig.skills.map((skill) => <li class="tag">{skill}</li>)}</ul>
          </div>
        </section>
        <section id="ai-workflow" class="section-grid" aria-labelledby="ai-title">
          <div><p class="eyebrow">02 / AI WORKFLOW</p><h2 id="ai-title" class="section-title">AI in the loop.<br />Ownership at every step.</h2></div>
          <div>
            <p class="text-xl leading-relaxed text-[#d5dbd0]">I use ChatGPT and Claude as practical development partners for understanding codebases, debugging, implementing features, and reviewing changes. I guide the work with clear requirements and stay responsible for the final result.</p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="AI collaboration skills"><li class="tag">ChatGPT</li><li class="tag">Claude</li><li class="tag">Context &amp; prompt design</li><li class="tag">Task decomposition</li><li class="tag">AI-assisted debugging</li><li class="tag">Code review &amp; verification</li></ul>
            <ol class="mt-8 grid gap-6 sm:grid-cols-2" aria-label="My AI-assisted development process">
              <li><p class="eyebrow mb-2">01 / DEFINE</p><h3 class="mb-2 font-semibold">Set context and acceptance criteria</h3><p class="muted">Clarify the business goal, inspect the existing code, and break the work into focused tasks with expected outcomes.</p></li>
              <li><p class="eyebrow mb-2">02 / COLLABORATE</p><h3 class="mb-2 font-semibold">Guide implementation in small steps</h3><p class="muted">Provide relevant context, compare proposed approaches, and iterate on targeted changes with ChatGPT and Claude.</p></li>
              <li><p class="eyebrow mb-2">03 / VERIFY</p><h3 class="mb-2 font-semibold">Review code and test behavior</h3><p class="muted">Inspect the diff, challenge assumptions, reproduce bugs, and check business logic, edge cases, and regressions.</p></li>
              <li><p class="eyebrow mb-2">04 / DELIVER</p><h3 class="mb-2 font-semibold">Document and hand over</h3><p class="muted">Summarize the changes and validation, call out remaining limitations, and prepare a clear pull request for review.</p></li>
            </ol>
          </div>
        </section>
        <section id="work" class="border-t border-white/15 py-16 md:py-20" aria-labelledby="work-title">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
            <div><p class="eyebrow">03 / SELECTED WORK</p><h2 id="work-title" class="section-title">Real projects.<br />Practical engineering.</h2></div>
            <p class="max-w-xs text-sm leading-relaxed text-[#b6beb3]">Payment workflows, messaging, CRM, and legacy modernization. My contribution, in context.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {siteConfig.projects.map((project, index) => (
              <article class="project-card">
                <p class="eyebrow mb-8">{String(index + 1).padStart(2, "0")} / {index < 2 ? "SEPAY" : "SELECTED PROJECT"}</p>
                <h3 class="mb-4 text-2xl font-semibold tracking-tight">{project.name}</h3>
                <p class="muted grow">{project.description}</p>
                <ul class="mb-6 mt-6 flex flex-wrap gap-2" aria-label={project.name + " technologies"}>{project.skills.map((skill) => <li class="tag">{skill}</li>)}</ul>
                {project.link ? <a class="project-link" href={project.link} target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a> : <p class="text-xs text-[#939e90]">Professional project · source code is private</p>}
              </article>
            ))}
          </div>
        </section>
        <section class="section-grid" aria-labelledby="experience-title">
          <div><p class="eyebrow">THE JOURNEY</p><h2 id="experience-title" class="section-title">Where I've<br />contributed.</h2></div>
          <div>
            {siteConfig.experience.map((role) => (
              <article class="experience-item">
                <div class="mb-3 flex flex-wrap justify-between gap-2"><h3 class="text-xl font-semibold">{role.company}</h3><p class="text-xs text-[#b6beb3]">{role.dateRange}</p></div>
                <p class="accent mb-4 text-sm">{role.title}</p>
                <ul class="list-disc space-y-2 pl-4 text-sm leading-relaxed text-[#b6beb3]">{role.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
              </article>
            ))}
            {siteConfig.education.map((education) => <div class="pt-6"><p class="eyebrow mb-3">EDUCATION</p><h3 class="font-semibold">{education.school}</h3><p class="muted mt-2">{education.degree} · {education.dateRange}</p></div>)}
          </div>
        </section>
        <section id="contact" class="border-t border-white/15 py-16 md:py-24" aria-labelledby="contact-title">
          <p class="eyebrow">04 / CONTACT</p>
          <h2 id="contact-title" class="my-6 text-4xl font-semibold tracking-tight md:text-6xl">Have a project in mind?<br /><span class="accent">Let's build it well.</span></h2>
          <p class="muted mb-8 max-w-xl">Looking for help with PHP development, API integrations, database optimization, or an existing application? Tell me what you're working on.</p>
          <a href={email} class="contact-email">{siteConfig.social.email} <span aria-hidden="true">↗</span></a>
          <div class="mt-8 flex gap-7 text-sm"><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a></div>
        </section>
      </main>
      <footer class="flex flex-wrap justify-between gap-4 border-t border-white/15 py-7 text-xs text-[#939e90]"><p>© {new Date().getFullYear()} {siteConfig.name}</p><p>Built with Astro & Tailwind CSS · Ho Chi Minh City</p></footer>
    </div>
  </body>
</html>
<style>
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 2rem; }
  :global(body) { margin: 0; font-family: Arial, Helvetica, sans-serif; }
  :global(a) { transition: color .2s, background-color .2s; }
  :global(a:hover) { color: #b5f36d; }
  :global(a:focus-visible) { outline: 2px solid #b5f36d; outline-offset: 6px; }
  :global(::selection) { background: #b5f36d; color: #111512; }
  .accent { color: #b5f36d; }
  .brand { font-size: 1.4rem; font-weight: 800; letter-spacing: -.06em; }
  .brand span { margin-left: .5rem; color: #a9b3a5; font-size: .7rem; font-weight: 400; letter-spacing: .12em; }
  .eyebrow { color: #b5f36d; font: 11px/1.6 monospace; letter-spacing: .12em; }
  .section-title { margin-top: 1rem; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.1; letter-spacing: -.04em; }
  .section-grid { display: grid; gap: 2.5rem; padding: 5rem 0; border-top: 1px solid #ffffff26; }
  .muted { color: #b6beb3; font-size: .95rem; line-height: 1.8; }
  .button-primary, .button-secondary { display: inline-flex; align-items: center; gap: 1.5rem; padding: .9rem 1.25rem; font-size: .85rem; font-weight: 600; border: 1px solid #ffffff30; border-radius: 4px; }
  .button-primary { color: #111512; background: #b5f36d; border-color: #b5f36d; }
  .button-primary:hover { color: #111512; background: #cef99e; }
  .system-card { padding: 1.5rem; border: 1px solid #ffffff26; border-radius: 8px; background: #182019; }
  .system-line { padding-top: 1.5rem; font-size: .9rem; }
  .system-line span { margin-right: 1rem; color: #7e9277; font: 11px monospace; }
  .status-dot { display: inline-block; width: 6px; height: 6px; margin-right: .5rem; border-radius: 50%; background: #b5f36d; }
  .tag { padding: .35rem .6rem; border: 1px solid #ffffff20; border-radius: 4px; color: #c6cebf; font: 11px/1.5 monospace; }
  .project-card { display: flex; flex-direction: column; padding: 2rem; border: 1px solid #ffffff26; border-radius: 8px; background: #171d18; }
  .project-link { color: #b5f36d; font-size: .8rem; }
  .experience-item { padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid #ffffff20; }
  .contact-email { overflow-wrap: anywhere; font-size: clamp(1rem, 3vw, 1.75rem); border-bottom: 1px solid #b5f36d; padding-bottom: .5rem; }
  .skip-link { position: absolute; top: -5rem; left: 1rem; padding: 1rem; z-index: 10; background: #b5f36d; color: #111512; }
  .skip-link:focus { top: 1rem; }
  @media (min-width: 768px) { .section-grid { grid-template-columns: 1fr 2fr; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } :global(a) { transition: none; } }
</style>
